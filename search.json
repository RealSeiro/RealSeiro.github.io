---
layout: null
permalink: /search.json
---
{%- assign all = site.posts | concat: site.projects -%}
[
{%- for e in all -%}
  {
    "title": {{ e.title | jsonify }},
    "url": {{ e.url | relative_url | jsonify }},
    "description": {{ e.description | default: "" | jsonify }},
    "tags": {{ e.tags | join: " " | jsonify }},
    "content": {{ e.content | strip_html | normalize_whitespace | truncatewords: 400 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
