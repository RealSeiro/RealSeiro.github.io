{
  "commitMessage": "Update blog: {{date}}",
  "autoCommitMessage": "Update blog: {{date}}",
  "commitDateFormat": "YYYY-MM-DD HH:mm",
  "autoPullOnBoot": true,
  "pullBeforePush": true,
  "disablePush": false,
  "syncMethod": "merge",
  "autoSaveInterval": 0,
  "autoPushInterval": 0,
  "autoPullInterval": 0,
  "showStatusBar": true
}
